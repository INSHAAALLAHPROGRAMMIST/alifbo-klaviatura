<?xml version="1.0" encoding="utf-8"?>
<!--
    Sizib chiqishga qarshi: ilova faqat ikki tarjima xizmati (Google Cloud Translation, Microsoft Azure Translator) bilan TLS orqali gaplasha oladi.
    Boshqa har qanday manzil uchun ishonchli sertifikat yo'q (bo'sh trust-anchors) va ochiq
    (shifrlanmagan) HTTP taqiqlangan, ya'ni kod xato qilib boshqa joyga ulanmoqchi bo'lsa ham ulana olmaydi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors />
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">translation.googleapis.com</domain>
        <domain includeSubdomains="false">api.cognitive.microsofttranslator.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
